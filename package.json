{
  "name": "@collabdt/core",
  "version": "0.0.40",
  "description": "CDT Core contains all the core technology for your CDT platform",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js"
    }
  },
  "sideEffects": [
    "**/*.css"
  ],
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "config"
  ],
  "scripts": {
    "build": "tsup && node scripts/copy-css.mjs && node scripts/build-types.mjs",
    "build:js": "tsup && node scripts/copy-css.mjs",
    "build:types": "node scripts/build-types.mjs",
    "build:types:strict": "tsc -p tsconfig.build.json",
    "dev": "tsup --watch --onSuccess \"node scripts/copy-css.mjs\"",
    "dev:link": "tsup --watch --onSuccess \"node scripts/copy-css.mjs && yalc push --no-scripts\"",
    "lint": "eslint src --ext .ts,.tsx",
    "prepublishOnly": "npm run build",
    "test": "jest",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "patch": "git add . && git commit -m \"$npm_config_m\" && git push && npm version patch",
    "minor": "git add . && git commit -m \"$npm_config_m\" && git push && npm version minor",
    "major": "git add . && git commit -m \"$npm_config_m\" && git push && npm version major"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CollabDigitalTwins/core.git"
  },
  "keywords": [
    "core",
    "collabdt",
    "cdt"
  ],
  "author": "Collab Digital Twins",
  "license": "AGPL-3.0-or-later",
  "bugs": {
    "url": "https://github.com/CollabDigitalTwins/core/issues"
  },
  "homepage": "https://github.com/CollabDigitalTwins/core#readme",
  "peerDependencies": {
    "@thatopen/components": "~3.4.0",
    "@thatopen/components-front": "~3.4.0",
    "@thatopen/fragments": "~3.4.0",
    "@thatopen/ui": "~3.4.0",
    "@thatopen/ui-obc": "~3.4.0",
    "framer-motion": "^12.0.0",
    "lucide-react": ">=0.500.0",
    "maplibre-gl": "^5.0.0",
    "next": "^15.0.0",
    "next-auth": "^5.0.0-beta.0",
    "next-intl": "^4.0.0",
    "next-themes": "^0.4.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "react-map-gl": "^8.0.0",
    "sonner": "^2.0.0",
    "swr": "^2.0.0",
    "three": ">=0.175.0",
    "web-ifc": ">=0.0.72"
  },
  "peerDependenciesMeta": {
    "@thatopen/components": {
      "optional": true
    },
    "@thatopen/components-front": {
      "optional": true
    },
    "@thatopen/fragments": {
      "optional": true
    },
    "@thatopen/ui": {
      "optional": true
    },
    "@thatopen/ui-obc": {
      "optional": true
    },
    "web-ifc": {
      "optional": true
    }
  },
